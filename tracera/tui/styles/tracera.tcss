/*
TRACERA — single-stream terminal-agent TUI (Claude Code style).

One main panel (rounded border) holding the conversation stream, a thin
inline status line, and the input pill. Color coding per row:
  cyan    = agent branding / in-flight
  green   = success
  red     = failure / errors
  purple  = user echo / collapsible rows
  dim     = in-progress / metadata
*/

Screen {
    background: #0e0e14;
    color: #e0e0ff;
}

/* ── Splash ─────────────────────────────────────────────────────────────── */

#splash-banner {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#splash-logo {
    color: #6cb6ff;
}

#splash-status {
    color: #9a9aa3;
}

/* ── Header (thin) ──────────────────────────────────────────────────────── */

#app-header {
    width: 1fr;
    height: 1;
    background: #14141c;
    padding: 0 2;
}

#header-left {
    width: 1fr;
    content-align: left middle;
}

#header-right {
    width: auto;
    content-align: right middle;
}

/* ── The single main panel ──────────────────────────────────────────────── */

#agent-panel-widget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#agent-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    border: round #3a3a4a;
    background: #12121a;
    padding: 0 1;
}

/* Stream — the only scrolling region, auto-scrolls to the latest row. */
#stream {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    border-bottom: solid #2a2a38;
    scrollbar-size: 1 1;
    scrollbar-color: #6cb6ff #1a1a24;
}

/* ── Message bubbles — sized to content, no fixed-height boxes ──────────── */

MessageWidget {
    width: 1fr;
    height: auto;
    margin: 1 0;
}

MessageWidget.msg-user {
    border: round #7a5aa0;
    background: #201730 90%;
    color: #dcdcf5;
    padding: 0 1;
}

MessageWidget.msg-assistant {
    border: round #3f6fb0;
    background: #10203a 90%;
    color: #e0e0ff;
    padding: 0 1;
}

MessageWidget.msg-error {
    border: round #f47067;
    background: #2a1513 90%;
    color: #ffb4ad;
    padding: 0 1;
}

MessageWidget.msg-tool {
    color: #60c060;
}

MessageWidget.msg-meta {
    color: #8080b0;
    text-style: dim;
}

/* ── Inline tool rows ───────────────────────────────────────────────────── */

ToolRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

/* ── Collapsible info rows (memory / search / repo / plan / debug) ──────── */

#info-row-toggle {
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #d2a8ff;
    text-style: bold;
    pointer: pointer;
}

#info-row-body {
    width: 1fr;
    height: auto;
    margin: 1 0;
    border: round #3a3a4a;
    background: #10101a;
    padding: 0 1;
}

.info-row-content {
    color: #c8c8e0;
}

/* ── Thinking disclosure ────────────────────────────────────────────────── */

ThinkingDisclosure,
CollapsibleRow {
    height: auto;
}

#reasoning-toggle {
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #9a9aa3;
    text-style: italic;
    pointer: pointer;
}

#reasoning-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
}

.reasoning-line {
    width: 1fr;
    padding: 0 2;
}

.reasoning-done {
    color: #4ac26b;
}

.reasoning-error {
    color: #f47067;
}

.reasoning-think {
    color: #9a9aa3;
}

.reasoning-tool {
    color: #dcdcf5;
}

.reasoning-step-done {
    color: #4ac26b;
}

.reasoning-step-active {
    color: #6cb6ff;
}

.reasoning-step-pending {
    color: #55555e;
}

/* ── Inline status line (thin, above the input, not a box) ──────────────── */

#status-line {
    width: 1fr;
    height: 1;
    background: #0e0e14;
    color: #9a9aa3;
}

/* ── Input pill (rounded, docked at the bottom) ─────────────────────────── */

#agent-input-area {
    width: 1fr;
    height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round #4a4a5a;
    background: #1a1a24;
}

#agent-input-area:focus-within {
    border: round #6cb6ff;
}

#agent-prompt-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #6cb6ff;
    text-style: bold;
}

#agent-input {
    width: 1fr;
    height: 1;
    background: transparent;
    border: none;
    padding: 0;
}

#agent-input:focus {
    background: transparent;
    border: none;
}

#input-hints {
    width: 1fr;
    height: 1;
    content-align: center middle;
    margin: 0 0 1 0;
    color: #55555e;
    text-style: dim;
}
