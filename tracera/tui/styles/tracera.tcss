/*
TRACERA — Claude Code premium TUI.

Design language:
  • Transparent background — terminal theme shows through everywhere
  • Accent: #da8548 (Claude orange) for branding, prompts, active states
  • Muted blue-grey (#6cb6ff) for tool/info rows
  • Green (#4ac26b) success · Red (#f47067) error · Purple (#d2a8ff) meta
  • All borders: round, never filled boxes
  • Compact, information-dense — no wasted vertical space
*/

/* ── Global ─────────────────────────────────────────────────────────────── */
/*
 * Colors come from theme presets injected by TraceraTUI.get_css_variables()
 * (see tracera/tui/theme.py): $t-accent $t-secondary $t-success $t-error $t-warning
 * $t-meta $t-muted $t-faint $t-text $t-surface $t-border $t-scroll.
 * /theme cycles presets live — no hex literals below on purpose.
 */

Screen {
    background: transparent;
    color: $t-text;
}

/* ── Header ─────────────────────────────────────────────────────────────── */

#app-header {
    width: 1fr;
    height: 1;
    padding: 0 2;
    background: transparent;
}

#header-left {
    width: 1fr;
    content-align: left middle;
}

#header-right {
    width: auto;
    content-align: right middle;
}

/* ── Main panel shell ───────────────────────────────────────────────────── */

#agent-panel-widget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#agent-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    border: round $t-border;
    padding: 0 1;
}

/* ── Conversation stream ────────────────────────────────────────────────── */

#stream {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    border-bottom: solid $t-border;
    scrollbar-size: 1 1;
    scrollbar-color: $t-accent transparent;
}

/* ── Message bubbles ────────────────────────────────────────────────────── */

MessageWidget {
    width: 1fr;
    height: auto;
    margin: 1 0;
}

/* User turn — accent border, Claude Code style */
MessageWidget.msg-user {
    border: round $t-accent;
    border-title-color: $t-accent;
    color: $t-text;
    padding: 0 1;
}

/* Assistant turn — secondary border */
MessageWidget.msg-assistant {
    border: round $t-border;
    border-title-color: $t-secondary;
    color: $t-text;
    padding: 0 1;
}

MessageWidget.msg-error {
    border: round $t-error;
    color: $t-error;
    padding: 0 1;
}

MessageWidget.msg-tool {
    color: $t-success;
}

MessageWidget.msg-meta {
    color: $t-muted;
    text-style: dim;
}

/* Markdown-rendered assistant messages */
MessageWidget.msg-markdown {
    border: round $t-border;
    padding: 0 1;
}

/* ── Boot banner ────────────────────────────────────────────────────────── */

.banner-block {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $t-accent;
}

/* ── Phase rows ─────────────────────────────────────────────────────────── */

PhaseRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
    margin: 0;
}

/* ── Tool rows ──────────────────────────────────────────────────────────── */

ToolRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
    margin: 0;
}

ToolRow:hover {
    background: $t-surface;
}

CollapsibleRow #info-row-toggle:hover {
    background: $t-surface;
}

ThinkingDisclosure #reasoning-toggle:hover {
    background: $t-surface;
}

/* ── Collapsible info rows ──────────────────────────────────────────────── */

CollapsibleRow {
    height: auto;
}

#info-row-toggle {
    width: 1fr;
    margin: 0 0 0 0;
    padding: 0 1;
    color: $t-meta;
    text-style: bold;
    pointer: pointer;
}

#info-row-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    border: round $t-border;
    padding: 0 1;
}

.info-row-content {
    color: $t-text;
}

/* ── Thinking disclosure ────────────────────────────────────────────────── */

ThinkingDisclosure {
    height: auto;
}

#reasoning-toggle {
    width: 1fr;
    margin: 0;
    padding: 0 1;
    color: $t-muted;
    text-style: italic;
    pointer: pointer;
}

#reasoning-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.reasoning-line {
    width: 1fr;
    padding: 0 1;
}

.reasoning-done  { color: $t-success; }
.reasoning-error { color: $t-error; }
.reasoning-think { color: $t-muted; }
.reasoning-tool  { color: $t-text; }

/* ── Status line ────────────────────────────────────────────────────────── */

#status-line {
    width: 1fr;
    height: 2;
    color: $t-muted;
    padding: 0 1;
}

/* ── Loader pill ────────────────────────────────────────────────────────── */

#loader-pill {
    display: none;
    width: 1fr;
    height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin: 1 0 0 0;
    padding: 0 2;
    border: round $t-accent;
    color: $t-accent;
}

#loader-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: $t-accent;
    text-style: bold;
}

#loader-label {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: $t-accent;
    text-style: bold;
}

#loader-stop {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-left: 1;
    color: $t-error;
    text-style: bold;
    pointer: pointer;
}

/* ── Input area ─────────────────────────────────────────────────────────── */

#agent-input-area {
    width: 1fr;
    height: auto;
    layout: vertical;
}

#attach-chips {
    display: none;
    width: 1fr;
    height: auto;
    layout: horizontal;
    margin: 1 0 0 0;
}

AttachmentChip {
    width: auto;
    height: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: round $t-faint;
    color: $t-text;
    pointer: pointer;
}

/* Suggestion dropdown — live slash-command autocomplete */
#suggestion-list {
    display: none;
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round $t-border;
    background: $t-surface;
    color: $t-text;
}

#suggestion-list.has-content {
    display: block;
}

/* Input bar — Claude Code orange accent on focus */
#agent-input-bar {
    width: 1fr;
    height: auto;
    min-height: 3;
    layout: horizontal;
    align-vertical: top;
    margin: 1 0 0 0;
    padding: 1 1;
    border: round $t-faint;
}

#agent-input-bar:focus-within {
    border: round $t-accent;
}

#agent-input-bar:focus-within #agent-prompt-icon {
    color: $t-accent;
    text-style: bold;
}

#attach-button {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: $t-muted;
    text-style: bold;
    pointer: pointer;
}

#agent-prompt-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: $t-accent;
    text-style: bold;
}

#agent-input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    background: transparent;
    border: none;
    padding: 0;
    color: $t-text;
}

#agent-input:focus {
    background: transparent;
    border: none;
}

#agent-input .text-area--cursor {
    background: $t-accent;
    color: $t-text;
}

#input-hints {
    width: 1fr;
    height: 1;
    content-align: center middle;
    margin: 0 0 1 0;
    color: $t-faint;
    text-style: dim;
}

/* Placeholder styling for the multiline editor */
#agent-input .text-area--placeholder {
    color: $t-muted;
    text-style: italic;
}

/* ── File picker modal ──────────────────────────────────────────────────── */

#picker-panel {
    width: 70;
    height: 24;
    layout: vertical;
    align: center middle;
    border: round $t-secondary;
    padding: 1 1;
}

#picker-title {
    width: 1fr;
    height: auto;
    color: $t-secondary;
    text-style: bold;
    margin-bottom: 1;
}

#picker-tree {
    width: 1fr;
    height: 1fr;
    color: $t-text;
    scrollbar-size: 1 1;
    scrollbar-color: $t-accent transparent;
}

#picker-hint {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: $t-faint;
    text-style: dim;
    margin-top: 1;
}

/* ── Provider switcher modal ────────────────────────────────────────────── */

#provider-panel {
    width: 64;
    height: auto;
    layout: vertical;
    align: center middle;
    border: round $t-accent;
    padding: 1 1;
}

#provider-title {
    width: 1fr;
    height: auto;
    color: $t-accent;
    text-style: bold;
    margin-bottom: 1;
}

#provider-list {
    width: 1fr;
    height: auto;
    color: $t-text;
    border: none;
}

#provider-list:focus {
    border: none;
}

#provider-list > ListItem {
    height: 1;
    padding: 0 0;
}

#provider-list > ListItem:hover {
    background: $t-surface;
}

#provider-list > ListItem.provider-active {
    background: $t-surface;
}

#provider-hint {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: $t-faint;
    text-style: dim;
    margin-top: 1;
}

/* ── Dashboard widget ───────────────────────────────────────────────────── */

#dashboard-container {
    width: 1fr;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round $t-border;
}

#dash-header   { width: 1fr; height: auto; color: $t-accent; text-style: bold; margin-bottom: 1; }
#dash-system   { width: 1fr; height: auto; color: $t-text; margin-bottom: 1; }
#dash-features { width: 1fr; height: auto; color: $t-muted; margin-bottom: 1; }
#dash-actions  { width: 1fr; height: auto; color: $t-muted; }

/* ── File context panel ─────────────────────────────────────────────────── */

#file-context-container {
    width: 1fr;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round $t-border;
}

#file-context-header { width: 1fr; height: auto; color: $t-secondary; text-style: bold; margin-bottom: 1; }
#file-context-list   { width: 1fr; height: auto; color: $t-text; }

/* ── Memory graph widget ────────────────────────────────────────────────── */

#memory-graph-container {
    width: 1fr;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round $t-border;
}

#memory-graph-header  { width: 1fr; height: auto; color: $t-meta; text-style: bold; margin-bottom: 1; }
#memory-graph-content { width: 1fr; height: auto; color: $t-text; }

/* ── Git status helpers ─────────────────────────────────────────────────── */

.git-status { color: $t-meta; text-style: bold; }
.git-dirty  { color: $t-warning; }
.git-clean  { color: $t-success; }
