/*
TRACERA — single-stream terminal-agent TUI (Claude Code style).

Panels are transparent: colored rounded borders + colored text only, never
a filled background, so the user's terminal theme shows through.
Color coding per row:
  cyan    = agent branding / in-flight
  green   = success
  red     = failure / errors
  purple  = user echo / collapsible rows / file-change summaries
  dim     = in-progress / metadata
*/

Screen {
    background: transparent;
    color: #e0e0ff;
}

/* ── Header (thin) ──────────────────────────────────────────────────────── */

#app-header {
    width: 1fr;
    height: 1;
    padding: 0 2;
}

#header-left {
    width: 1fr;
    content-align: left middle;
}

#header-right {
    width: auto;
    content-align: right middle;
}

/* ── The single main panel ──────────────────────────────────────────────── */

#agent-panel-widget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#agent-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    border: round #3a3a4a;
    padding: 0 1;
}

/* Stream — the only scrolling region, auto-scrolls to the latest row. */
#stream {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    border-bottom: solid #2a2a38;
    scrollbar-size: 1 1;
    scrollbar-color: #6cb6ff #1a1a24;
}

/* ── Message bubbles — sized to content, no fixed-height boxes ──────────── */

MessageWidget {
    width: 1fr;
    height: auto;
    margin: 1 0;
}

MessageWidget.msg-user {
    border: round #7a5aa0;
    color: #dcdcf5;
    padding: 0 1;
}

MessageWidget.msg-assistant {
    border: round #3f6fb0;
    color: #e0e0ff;
    padding: 0 1;
}

MessageWidget.msg-error {
    border: round #f47067;
    color: #ffb4ad;
    padding: 0 1;
}

MessageWidget.msg-tool {
    color: #60c060;
}

MessageWidget.msg-meta {
    color: #8080b0;
    text-style: dim;
}

/* ── Boot banner (reproduced from the CLI's scrollback output) ──────────── */

.banner-block {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #6cb6ff;
}

/* ── Inline tool rows ───────────────────────────────────────────────────── */

ToolRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

PhaseRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

/* ── Collapsible info rows (memory / search / repo / plan / debug) ──────── */

#info-row-toggle {
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #d2a8ff;
    text-style: bold;
    pointer: pointer;
}

#info-row-body {
    width: 1fr;
    height: auto;
    margin: 1 0;
    border: round #3a3a4a;
    padding: 0 1;
}

.info-row-content {
    color: #c8c8e0;
}

/* ── Thinking disclosure ────────────────────────────────────────────────── */

ThinkingDisclosure,
CollapsibleRow {
    height: auto;
}

#reasoning-toggle {
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #9a9aa3;
    text-style: italic;
    pointer: pointer;
}

#reasoning-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
}

.reasoning-line {
    width: 1fr;
    padding: 0 2;
}

.reasoning-done {
    color: #4ac26b;
}

.reasoning-error {
    color: #f47067;
}

.reasoning-think {
    color: #9a9aa3;
}

.reasoning-tool {
    color: #dcdcf5;
}

/* ── Inline status line (thin, above the input, not a box) ──────────────── */

#status-line {
    width: 1fr;
    height: 1;
    color: #9a9aa3;
}

/* ── Loader pill (replaces the input while a request is in flight) ──────── */

#loader-pill {
    display: none;
    width: 1fr;
    height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round #6cb6ff;
    color: #6cb6ff;
}

#loader-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #6cb6ff;
    text-style: bold;
}

#loader-label {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #6cb6ff;
    text-style: bold;
}

#loader-stop {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-left: 1;
    color: #f47067;
    text-style: bold;
    pointer: pointer;
}

/* ── Input pill (rounded, docked at the bottom) ─────────────────────────── */

#agent-input-area {
    width: 1fr;
    height: auto;
    layout: vertical;
}

/* Attachment chips — above the pill, hidden until something is attached. */
#attach-chips {
    display: none;
    width: 1fr;
    height: auto;
    layout: horizontal;
    margin: 1 0 0 0;
}

AttachmentChip {
    width: auto;
    height: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: round #4a4a5a;
    color: #dcdcf5;
    pointer: pointer;
}

#agent-input-bar {
    width: 1fr;
    height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round #4a4a5a;
}

#agent-input-bar:focus-within {
    border: round #6cb6ff;
}

#attach-button {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #d2a8ff;
    text-style: bold;
    pointer: pointer;
}

#agent-prompt-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #6cb6ff;
    text-style: bold;
}

#agent-input {
    width: 1fr;
    height: 1;
    background: transparent;
    border: none;
    padding: 0;
}

#agent-input:focus {
    background: transparent;
    border: none;
}

#input-hints {
    width: 1fr;
    height: 1;
    content-align: center middle;
    margin: 0 0 1 0;
    color: #55555e;
    text-style: dim;
}

/* ── Attachment file picker (modal) ─────────────────────────────────────── */

#picker-panel {
    width: 70;
    height: 24;
    layout: vertical;
    align: center middle;
    border: round #3f6fb0;
    padding: 1 1;
}

#picker-title {
    width: 1fr;
    height: auto;
    color: #6cb6ff;
    text-style: bold;
    margin-bottom: 1;
}

#picker-tree {
    width: 1fr;
    height: 1fr;
    color: #dcdcf5;
    scrollbar-size: 1 1;
    scrollbar-color: #6cb6ff #1a1a24;
}

#picker-hint {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: #55555e;
    text-style: dim;
    margin-top: 1;
}

/* ── Provider / model switcher (modal) ───────────────────────────────────── */

#provider-panel {
    width: 64;
    height: auto;
    layout: vertical;
    align: center middle;
    border: round #b071e8;
    padding: 1 1;
}

#provider-title {
    width: 1fr;
    height: auto;
    color: #b071e8;
    text-style: bold;
    margin-bottom: 1;
}

#provider-list {
    width: 1fr;
    height: auto;
    color: #dcdcf5;
    border: none;
}

#provider-list:focus {
    border: none;
}

#provider-list > ListItem {
    height: 1;
    padding: 0 0;
}

#provider-list > ListItem:hover {
    background: #2a2a3d;
}

#provider-list > ListItem.provider-active {
    background: #2a2a3d;
}

#provider-hint {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: #55555e;
    text-style: dim;
    margin-top: 1;
}
