/*
TRACERA — Claude Code premium TUI.

Design language:
  • Transparent background — terminal theme shows through everywhere
  • Accent: #da8548 (Claude orange) for branding, prompts, active states
  • Muted blue-grey (#6cb6ff) for tool/info rows
  • Green (#4ac26b) success · Red (#f47067) error · Purple (#d2a8ff) meta
  • All borders: round, never filled boxes
  • Compact, information-dense — no wasted vertical space
*/

/* ── Global ─────────────────────────────────────────────────────────────── */

Screen {
    background: transparent;
    color: #ebebf0;
}

/* ── Header ─────────────────────────────────────────────────────────────── */

#app-header {
    width: 1fr;
    height: 1;
    padding: 0 2;
    background: transparent;
}

#header-left {
    width: 1fr;
    content-align: left middle;
}

#header-right {
    width: auto;
    content-align: right middle;
}

/* ── Main panel shell ───────────────────────────────────────────────────── */

#agent-panel-widget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#agent-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    border: round #2d2d3d;
    padding: 0 1;
}

/* ── Conversation stream ────────────────────────────────────────────────── */

#stream {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    border-bottom: solid #252535;
    scrollbar-size: 1 1;
    scrollbar-color: #da8548 #18181f;
    scrollbar-background: #18181f;
}

/* ── Message bubbles ────────────────────────────────────────────────────── */

MessageWidget {
    width: 1fr;
    height: auto;
    margin: 1 0;
}

/* User turn — warm orange border, Claude Code style */
MessageWidget.msg-user {
    border: round #da8548;
    border-title-color: #da8548;
    color: #ebebf0;
    padding: 0 1;
}

/* Assistant turn — cool blue border */
MessageWidget.msg-assistant {
    border: round #3a5a8a;
    border-title-color: #6cb6ff;
    color: #ebebf0;
    padding: 0 1;
}

MessageWidget.msg-error {
    border: round #f47067;
    color: #ffb4ad;
    padding: 0 1;
}

MessageWidget.msg-tool {
    color: #4ac26b;
}

MessageWidget.msg-meta {
    color: #6a6a80;
    text-style: dim;
}

/* Markdown-rendered assistant messages */
MessageWidget.msg-markdown {
    border: round #3a5a8a;
    padding: 0 1;
}

/* ── Boot banner ────────────────────────────────────────────────────────── */

.banner-block {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #da8548;
}

/* ── Phase rows ─────────────────────────────────────────────────────────── */

PhaseRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
    margin: 0;
}

/* ── Tool rows ──────────────────────────────────────────────────────────── */

ToolRow {
    width: 1fr;
    height: auto;
    padding: 0 1;
    margin: 0;
}

ToolRow:hover {
    background: #1e1e2a;
}

CollapsibleRow #info-row-toggle:hover {
    background: #1e1e2a;
}

ThinkingDisclosure #reasoning-toggle:hover {
    background: #1e1e2a;
}

/* ── Collapsible info rows ──────────────────────────────────────────────── */

CollapsibleRow {
    height: auto;
}

#info-row-toggle {
    width: 1fr;
    margin: 0 0 0 0;
    padding: 0 1;
    color: #d2a8ff;
    text-style: bold;
    pointer: pointer;
}

#info-row-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    border: round #2d2d3d;
    padding: 0 1;
}

.info-row-content {
    color: #c0c0d8;
}

/* ── Thinking disclosure ────────────────────────────────────────────────── */

ThinkingDisclosure {
    height: auto;
}

#reasoning-toggle {
    width: 1fr;
    margin: 0;
    padding: 0 1;
    color: #6a6a80;
    text-style: italic;
    pointer: pointer;
}

#reasoning-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.reasoning-line {
    width: 1fr;
    padding: 0 1;
}

.reasoning-done  { color: #4ac26b; }
.reasoning-error { color: #f47067; }
.reasoning-think { color: #6a6a80; }
.reasoning-tool  { color: #c0c0d8; }

/* ── Status line ────────────────────────────────────────────────────────── */

#status-line {
    width: 1fr;
    height: 2;
    color: #6a6a80;
    padding: 0 1;
}

/* ── Loader pill ────────────────────────────────────────────────────────── */

#loader-pill {
    display: none;
    width: 1fr;
    height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin: 1 0 0 0;
    padding: 0 2;
    border: round #da8548;
    color: #da8548;
}

#loader-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #da8548;
    text-style: bold;
}

#loader-label {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #da8548;
    text-style: bold;
}

#loader-stop {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-left: 1;
    color: #f47067;
    text-style: bold;
    pointer: pointer;
}

/* ── Input area ─────────────────────────────────────────────────────────── */

#agent-input-area {
    width: 1fr;
    height: auto;
    layout: vertical;
}

#attach-chips {
    display: none;
    width: 1fr;
    height: auto;
    layout: horizontal;
    margin: 1 0 0 0;
}

AttachmentChip {
    width: auto;
    height: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: round #3a3a4a;
    color: #ebebf0;
    pointer: pointer;
}

/* Suggestion dropdown — live slash-command autocomplete */
#suggestion-list {
    display: none;
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round #2d2d3d;
    background: #18181f;
    color: #ebebf0;
}

#suggestion-list.has-content {
    display: block;
}

/* Input bar — Claude Code orange accent on focus */
#agent-input-bar {
    width: 1fr;
    height: auto;
    min-height: 3;
    layout: horizontal;
    align-vertical: top;
    margin: 1 0 0 0;
    padding: 1 1;
    border: round #3a3a4a;
}

#agent-input-bar:focus-within {
    border: round #da8548;
}

#agent-input-bar:focus-within #agent-prompt-icon {
    color: #da8548;
    text-style: bold;
}

#attach-button {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #6a6a80;
    text-style: bold;
    pointer: pointer;
}

#agent-prompt-icon {
    width: auto;
    height: 1;
    content-align: center middle;
    margin-right: 1;
    color: #da8548;
    text-style: bold;
}

#agent-input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    background: transparent;
    border: none;
    padding: 0;
    color: #ebebf0;
}

#agent-input:focus {
    background: transparent;
    border: none;
}

#agent-input .text-area--cursor {
    background: #da8548;
    color: #18181f;
}

#input-hints {
    width: 1fr;
    height: 1;
    content-align: center middle;
    margin: 0 0 1 0;
    color: #3a3a4a;
    text-style: dim;
}

/* Placeholder styling for the multiline editor */
#agent-input .text-area--placeholder {
    color: #4a4a5a;
    text-style: italic;
}

/* ── File picker modal ──────────────────────────────────────────────────── */

#picker-panel {
    width: 70;
    height: 24;
    layout: vertical;
    align: center middle;
    border: round #3a5a8a;
    padding: 1 1;
}

#picker-title {
    width: 1fr;
    height: auto;
    color: #6cb6ff;
    text-style: bold;
    margin-bottom: 1;
}

#picker-tree {
    width: 1fr;
    height: 1fr;
    color: #ebebf0;
    scrollbar-size: 1 1;
    scrollbar-color: #da8548 #18181f;
}

#picker-hint {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: #3a3a4a;
    text-style: dim;
    margin-top: 1;
}

/* ── Provider switcher modal ────────────────────────────────────────────── */

#provider-panel {
    width: 64;
    height: auto;
    layout: vertical;
    align: center middle;
    border: round #da8548;
    padding: 1 1;
}

#provider-title {
    width: 1fr;
    height: auto;
    color: #da8548;
    text-style: bold;
    margin-bottom: 1;
}

#provider-list {
    width: 1fr;
    height: auto;
    color: #ebebf0;
    border: none;
}

#provider-list:focus {
    border: none;
}

#provider-list > ListItem {
    height: 1;
    padding: 0 0;
}

#provider-list > ListItem:hover {
    background: #252535;
}

#provider-list > ListItem.provider-active {
    background: #252535;
}

#provider-hint {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: #3a3a4a;
    text-style: dim;
    margin-top: 1;
}

/* ── Dashboard widget ───────────────────────────────────────────────────── */

#dashboard-container {
    width: 1fr;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round #2d2d3d;
}

#dash-header   { width: 1fr; height: auto; color: #da8548; text-style: bold; margin-bottom: 1; }
#dash-system   { width: 1fr; height: auto; color: #ebebf0; margin-bottom: 1; }
#dash-features { width: 1fr; height: auto; color: #6a6a80; margin-bottom: 1; }
#dash-actions  { width: 1fr; height: auto; color: #6a6a80; }

/* ── File context panel ─────────────────────────────────────────────────── */

#file-context-container {
    width: 1fr;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round #2d2d3d;
}

#file-context-header { width: 1fr; height: auto; color: #6cb6ff; text-style: bold; margin-bottom: 1; }
#file-context-list   { width: 1fr; height: auto; color: #ebebf0; }

/* ── Memory graph widget ────────────────────────────────────────────────── */

#memory-graph-container {
    width: 1fr;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round #2d2d3d;
}

#memory-graph-header  { width: 1fr; height: auto; color: #d2a8ff; text-style: bold; margin-bottom: 1; }
#memory-graph-content { width: 1fr; height: auto; color: #ebebf0; }

/* ── Git status helpers ─────────────────────────────────────────────────── */

.git-status { color: #d2a8ff; text-style: bold; }
.git-dirty  { color: #ffd700; }
.git-clean  { color: #4ac26b; }
