/* ═══════════════════════════════════════════════════════════════════════════
   TRACERA — monochrome terminal-agent theme (Claude Code / gum inspired).

   Standard boxes and text. No colored fills, no neon — only thin borders,
   monochrome text, and semantic accent colors (green ✓, red ✗, yellow ●).
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Design tokens ──────────────────────────────────────────────────────── */

$bg:            #0d0d0f;
$bg-panel:      #121214;
$bg-elevated:   #16161a;
$bg-hover:      #1d1d24;
$bg-active:     #24242c;

$border:        #2f2f38;
$border-subtle: #222227;

$text:          #e8e8ea;
$text-muted:    #9a9aa3;
$text-dim:      #5f5f68;

$green:         #4ac26b;
$red:           #f47067;
$yellow:        #d4a72c;
$blue:          #6cb6ff;
$purple:        #d2a8ff;

/* ── Root ──────────────────────────────────────────────────────────────── */

Screen {
    background: $bg;
    color: $text;
    layers: base overlay;
}

/* ── Splash overlay (typewriter animation) ──────────────────────────────── */

#splash-overlay {
    layer: overlay;
    align: center middle;
    width: 100%;
    height: 100%;
    background: $bg;
    layout: vertical;
    padding: 0 6;
}

#splash-logo {
    content-align: center middle;
    color: $text;
    text-style: bold;
    height: 3;
}

#splash-status {
    content-align: center middle;
    color: $text-muted;
    height: 3;
}

/* ── Header (single slim row) ───────────────────────────────────────────── */

#app-header {
    height: 1;
    layout: horizontal;
    background: $bg-panel;
    border-bottom: solid $border-subtle;
    padding: 0 2;
}

#header-left {
    width: 1fr;
    content-align: left middle;
    color: $text;
}

#header-right {
    width: auto;
    content-align: right middle;
    color: $text-muted;
}

/* ── Main layout ────────────────────────────────────────────────────────── */

#main-layout {
    height: 1fr;
    width: 100%;
    layout: horizontal;
    background: $bg;
}

#agent-panel-widget {
    width: 1fr;
    height: 100%;
}

#right-sidebar {
    width: 44;
    height: 100%;
    background: $bg-panel;
    border-left: solid $border;
    layout: vertical;
}

/* ── Status bar (bottom) ────────────────────────────────────────────────── */

#status-bar {
    height: 1;
    background: $bg-panel;
    border-top: solid $border-subtle;
    layout: horizontal;
    padding: 0 1;
}

/* ── Panel titles (plain boxes, no fills) ───────────────────────────────── */

.panel-title {
    height: 1;
    color: $text;
    text-style: bold;
    padding: 0 2;
    border-bottom: solid $border-subtle;
    background: $bg-elevated;
}

.panel-title-cyan { color: $text; }
.panel-title-green { color: $text; }
.panel-title-gold { color: $text; }
.panel-title-purple { color: $text; }

/* ── Thinking panel (live agent trace) ──────────────────────────────────── */

#thinking-panel-widget {
    height: auto;
    max-height: 26%;
    min-height: 5;
    layout: vertical;
    background: $bg-panel;
    border-bottom: solid $border-subtle;
}

#thinking-toggle {
    color: $text;
    text-style: bold;
}

#thinking-toggle:hover {
    background: $bg-hover;
    color: $text;
}

#thinking-trace {
    height: 11;
    background: $bg;
    padding: 0 1;
    scrollbar-color: $text-dim $bg-panel;
    scrollbar-size: 1 1;
    border: none;
}

/* ── Collapsible per-turn Thinking… accordion in the conversation ───────── */

.msg-reasoning {
    margin: 0 0 1 0;
    padding: 0 2;
    border: solid $border-subtle;
    border-left: solid $border;
}

#reasoning-toggle {
    color: $text-muted;
    text-style: italic;
}

#reasoning-toggle:hover {
    color: $text;
    text-style: bold italic;
    background: $bg-hover;
}

#reasoning-body {
    padding: 0 1;
    margin: 1 0;
    border-left: solid $border-subtle;
}

.reasoning-line {
    color: $text-muted;
    padding: 0 1;
}

.reasoning-step-done { color: $text-muted; }
.reasoning-step-active { color: $blue; }
.reasoning-step-pending { color: $text-dim; }
.reasoning-think { color: $text-dim; }
.reasoning-tool { color: $blue; }
.reasoning-done { color: $green; }
.reasoning-error { color: $red; }

/* ── Conversation panel ─────────────────────────────────────────────────── */

#agent-panel {
    height: 1fr;
    border: none;
    background: $bg;
}

#agent-log {
    height: 1fr;
    background: $bg;
    padding: 1 2;
    border: none;
    scrollbar-color: $text-dim $bg-panel;
    scrollbar-size: 1 1;
}

#activity-line {
    height: 1;
    background: $bg;
    color: $blue;
    padding: 0 2;
    border-top: solid $border-subtle;
}

#agent-input-area {
    height: 3;
    background: $bg-elevated;
    border-top: solid $border-subtle;
    layout: horizontal;
    padding: 0 1;
}

#input-hints {
    height: 1;
    color: $text-dim;
    background: $bg;
    padding: 0 3;
    border-top: solid $border-subtle;
}

#agent-prompt-icon {
    width: 3;
    content-align: center middle;
    color: $blue;
    text-style: bold;
}

#agent-input {
    width: 1fr;
    background: transparent;
    border: none;
    color: $text;
    padding: 0;
}

#agent-input:focus {
    border: none;
    background: transparent;
}

/* ── Message bubbles — standard boxes ───────────────────────────────────── */

.msg-user {
    background: $bg-panel;
    color: $text;
    border: solid $border-subtle;
    border-left: solid $blue;
    padding: 1 2;
    margin: 1 0;
}

.msg-assistant {
    background: $bg;
    color: $text;
    border: solid $border-subtle;
    padding: 1 2;
    margin: 1 0;
}

.msg-tool {
    background: $bg;
    color: $text-muted;
    border-left: solid $border;
    padding: 0 2;
    margin: 0;
}

.msg-error {
    background: $bg;
    color: $red;
    border-left: solid $red;
    padding: 1 2;
    margin: 1 0;
}

.msg-thinking {
    color: $text-muted;
    text-style: italic;
    padding: 0 2;
    margin: 0;
}

.msg-meta {
    color: $text-dim;
    padding: 0 2;
    margin: 0;
}

/* ── Tool log panel ─────────────────────────────────────────────────────── */

#tool-log-widget {
    height: 1fr;
    min-height: 5;
}

#tool-log {
    height: 1fr;
    background: $bg-panel;
    padding: 0 1;
    scrollbar-color: $text-dim $bg-panel;
    scrollbar-size: 1 1;
    border: none;
}

/* ── Plan panel ─────────────────────────────────────────────────────────── */

#plan-panel {
    height: 1fr;
    background: $bg-panel;
    border: none;
}

#plan-list {
    height: 1fr;
    background: $bg-panel;
    padding: 1 1;
    scrollbar-color: $text-dim $bg-panel;
    scrollbar-size: 1 1;
    border: none;
}

/* ── Memory panel ───────────────────────────────────────────────────────── */

#memory-panel {
    height: 1fr;
    background: $bg-panel;
}

#memory-list {
    height: 1fr;
    background: $bg-panel;
    padding: 1 1;
    scrollbar-color: $text-dim $bg-panel;
    scrollbar-size: 1 1;
    border: none;
}

/* ── Stats / Status card ────────────────────────────────────────────────── */

#stats-panel {
    height: auto;
    background: $bg-panel;
    padding: 1 2;
    border-top: solid $border-subtle;
}

#context-panel,
#history-panel {
    height: auto;
    background: $bg-panel;
    padding: 0 2 1 2;
    border-top: solid $border-subtle;
}

#context-display,
#history-display {
    color: $text;
    padding: 1 0 0 0;
}

.context-row {
    layout: horizontal;
    height: 1;
}

.context-key {
    width: 12;
    color: $text-muted;
}

.context-val {
    width: 1fr;
    color: $text;
}

.stat-row {
    layout: horizontal;
    height: 1;
}

.stat-label {
    color: $text-muted;
    width: 12;
}

.stat-value {
    color: $text;
    text-style: bold;
    width: 1fr;
}

.stat-value-green { color: $green; }
.stat-value-gold { color: $yellow; }

/* ── Tabs ───────────────────────────────────────────────────────────────── */

TabbedContent {
    height: 26%;
    min-height: 7;
    background: $bg-panel;
    border: none;
    border-top: solid $border-subtle;
}

TabPane {
    background: $bg-panel;
    border: none;
    padding: 0;
}

Tabs {
    background: $bg-elevated;
    border-bottom: solid $border-subtle;
    height: 2;
}

Tab {
    color: $text-muted;
    background: $bg-elevated;
    padding: 0 2;
    border: none;
}

Tab:hover {
    color: $text;
    background: $bg-hover;
}

Tab.-active {
    color: $text;
    text-style: bold;
    background: $bg-panel;
    border-bottom: solid $blue;
}

/* ── Input ──────────────────────────────────────────────────────────────── */

Input {
    background: $bg-elevated;
    border: solid $border-subtle;
    color: $text;
    padding: 0 1;
}

Input:focus {
    border: solid $border;
    background: $bg-panel;
}

/* ── Buttons ────────────────────────────────────────────────────────────── */

Button {
    background: $bg-elevated;
    color: $text;
    border: solid $border;
    padding: 0 2;
}

Button:hover {
    background: $bg-hover;
    color: $text;
    border: solid $border;
}

/* ── Scrollbar ──────────────────────────────────────────────────────────── */

ScrollBar {
    background: $bg-panel;
    color: $text-dim;
}

ScrollBar > .scrollbar--bar {
    color: $text-muted;
}

/* ── Footer / key binding hints ─────────────────────────────────────────── */

Footer {
    background: $bg-panel;
    color: $text-muted;
    border-top: solid $border-subtle;
}

Footer > .footer--key {
    background: $bg-elevated;
    color: $text;
    text-style: bold;
}

Footer > .footer--description {
    color: $text-muted;
}
