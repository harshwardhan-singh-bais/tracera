# ══════════════════════════════════════════════════════════════════════════════
#  TRACERA — CodePilotX Environment Configuration
#  Copy this file to .env and fill in the values you need.
#  Only the keys for providers you actually use are required.
# ══════════════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────────────
TRACERA_PROFILE=development          # local | development | production | evaluation
TRACERA_WORKSPACE=.                  # path to the workspace root (default: cwd)
TRACERA_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
TRACERA_LOG_FILE=.tracera/logs/tracera.log
TRACERA_DATA_DIR=.tracera            # directory for all TRACERA state/index data

# ── Default Model ─────────────────────────────────────────────────────────────
TRACERA_DEFAULT_PROVIDER=gemini        # gemini | ollama | groq | mistral
TRACERA_DEFAULT_MODEL=gemini-2.5-pro # depends on provider
TRACERA_DEFAULT_TEMPERATURE=0.2
TRACERA_DEFAULT_MAX_TOKENS=8192

# ── Safety / Resource Limits ──────────────────────────────────────────────────
TRACERA_MAX_ITERATIONS=50            # max agent loop iterations per task
TRACERA_MAX_TOOL_CALLS=200           # max total tool executions
TRACERA_MAX_CONTEXT_TOKENS=128000    # max tokens in LLM context
TRACERA_COMMAND_TIMEOUT=30           # seconds before shell command is killed
TRACERA_INDEXING_MAX_FILE_SIZE=2097152  # bytes (2 MB) — skip larger files

# ── Security ──────────────────────────────────────────────────────────────────
TRACERA_SECRET_KEY=change-me-in-production   # internal signing / HMAC key
TRACERA_ALLOWED_SHELL_COMMANDS=git,python,python3,pytest,npm,node,cargo,make,ruff,mypy
TRACERA_REQUIRE_CONFIRMATION_FOR=delete,write,run_command  # comma-separated tool names

# ══════════════════════════════════════════════════════════════════════════════
#  LLM PROVIDERS
# ══════════════════════════════════════════════════════════════════════════════



# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
GOOGLE_CLOUD_PROJECT=my-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Models: gemini-2.5-pro, gemini-2.5-flash, gemini-1.5-pro

# ── Groq (ultra-fast inference) ───────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Models: llama-3.1-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it

# ── Together AI ───────────────────────────────────────────────────────────────
TOGETHER_API_KEY=...
# Models: meta-llama/Meta-Llama-3.1-70B-Instruct, mistralai/Mixtral-8x7B

# ── Mistral AI ────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=...
# Models: mistral-large-latest, mistral-medium-latest, codestral-latest

# ── Cohere ────────────────────────────────────────────────────────────────────
COHERE_API_KEY=...
# Models: command-r-plus, command-r

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Models: llama3.2, qwen2.5-coder, deepseek-coder-v2, codellama, phi4

# ── LM Studio / vLLM / LiteLLM (OpenAI-compatible) ──────────────────────────
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=not-required

# ══════════════════════════════════════════════════════════════════════════════
#  EMBEDDINGS
# ══════════════════════════════════════════════════════════════════════════════

# ── Hugging Face (for private embedding models) ───────────────────────────────
HUGGINGFACE_TOKEN=hf_...

# ── Embedding model to use locally ───────────────────────────────────────────
# TRACERA ships with local ONNX embeddings — no API needed by default.
TRACERA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRACERA_EMBEDDING_DEVICE=cpu        # cpu | cuda | mps



# ══════════════════════════════════════════════════════════════════════════════
#  VECTOR DATABASE
# ══════════════════════════════════════════════════════════════════════════════

LANCEDB_URI=.tracera/index/lancedb   # local path OR s3://bucket/path
# S3-backed LanceDB:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# ══════════════════════════════════════════════════════════════════════════════
#  MCP SERVERS (Model Context Protocol — Phase 39+)
# ══════════════════════════════════════════════════════════════════════════════

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=my-org

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ── Linear ────────────────────────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_...

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...

# ── Postgres (database MCP) ───────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...

# ══════════════════════════════════════════════════════════════════════════════
#  OBSERVABILITY
# ══════════════════════════════════════════════════════════════════════════════

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=tracera

# ── Weights & Biases (for evaluation tracking) ────────────────────────────────
WANDB_API_KEY=...
WANDB_PROJECT=tracera-eval

# ══════════════════════════════════════════════════════════════════════════════
#  SEARCH / WEB TOOLS (future agent tools)
# ══════════════════════════════════════════════════════════════════════════════

TAVILY_API_KEY=tvly-...
BRAVE_SEARCH_API_KEY=BSA...
SERPER_API_KEY=...
